// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  STAFF
  ACCOUNTANT
}

enum ProductCategory {
  WHOLE_SPICES
  POWDER_SPICES
  DRY_FRUITS
  OTHER_PRODUCTS
}

enum Unit {
  KG
  GRAM
  BAG
  PIECE
}

enum InvoiceType {
  GST_INVOICE
  NON_GST_INVOICE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
}

enum MarketLocation {
  MUMBAI
  PUNE
  SOLAPUR
  DHARASHIV
}

enum StockMovementType {
  PURCHASE
  SALE
  DAMAGED
  ADJUSTMENT
}

// User Management
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String?
  name          String
  phone         String?
  role          UserRole  @default(STAFF)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([email])
  @@index([role])
}

// Product Management (Module 2)
model Product {
  id                String    @id @default(cuid())
  name              String
  marathiName       String?
  sku               String    @unique
  category          ProductCategory
  unit              Unit
  hsnCode           String?
  gstPercentage     Float     @default(5)
  purchaseRate      Float
  sellingRate       Float
  currentStock      Float     @default(0)
  minimumStockLevel Float     @default(0)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  purchaseItems     PurchaseItem[]
  invoiceItems      InvoiceItem[]
  stockMovements    StockMovement[]
  rateHistories     RateHistory[]

  @@index([category])
  @@index([sku])
}

// Supplier Management (Module 3)
model Supplier {
  id                String    @id @default(cuid())
  name              String
  contactPerson     String?
  mobile            String
  whatsapp          String?
  city              String
  address           String
  gstNumber         String?
  productCategories String[]  @default([])
  rating            Float     @default(0)
  notes             String?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  purchases         Purchase[]
  paymentHistory    SupplierPayment[]

  @@index([city])
  @@index([name])
}

// Customer Management (Module 5)
model Customer {
  id              String    @id @default(cuid())
  name            String
  mobile          String    @unique
  address         String
  gstNumber       String?
  creditLimit     Float     @default(0)
  outstandingAmount Float  @default(0)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  invoices        Invoice[]
  paymentHistory  CustomerPayment[]
  ledgerEntries   Ledger[]

  @@index([name])
  @@index([mobile])
}

// Purchase Management (Module 4)
model Purchase {
  id                String    @id @default(cuid())
  supplierId        String
  invoiceNumber     String    @unique
  purchaseDate      DateTime
  totalAmount       Float
  gstAmount         Float     @default(0)
  transportCost     Float     @default(0)
  loadingCost       Float     @default(0)
  otherCharges      Float     @default(0)
  notes             String?
  isCompleted       Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  supplier          Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  items             PurchaseItem[]
  payments          SupplierPayment[]

  @@index([supplierId])
  @@index([purchaseDate])
}

model PurchaseItem {
  id            String    @id @default(cuid())
  purchaseId    String
  productId     String
  quantity      Float
  rate          Float
  gstPercentage Float     @default(5)
  amount        Float

  // Relations
  purchase      Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product       Product   @relation(fields: [productId], references: [id])

  @@unique([purchaseId, productId])
}

// Billing System (Module 6)
model Invoice {
  id                String    @id @default(cuid())
  invoiceNumber     String    @unique
  customerId        String
  invoiceDate       DateTime
  dueDate           DateTime?
  invoiceType       InvoiceType @default(GST_INVOICE)
  status            InvoiceStatus @default(DRAFT)
  customerName      String      @default("")
  customerMobile    String?

  subtotal          Float
  discountAmount    Float     @default(0)
  discountPercent   Float     @default(0)
  taxableAmount     Float
  gstAmount         Float
  totalAmount       Float

  paidAmount        Float     @default(0)
  notes             String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  customer          Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items             InvoiceItem[]
  payments          CustomerPayment[]

  @@index([customerId])
  @@index([invoiceDate])
  @@index([status])
}

model InvoiceItem {
  id          String    @id @default(cuid())
  invoiceId   String
  productId   String
  quantity    Float
  rate        Float
  gstPercent  Float
  amount      Float

  // Relations
  invoice     Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id])

  @@unique([invoiceId, productId])
}

// Inventory Management (Module 7)
model StockMovement {
  id              String    @id @default(cuid())
  productId       String
  movementType    StockMovementType
  quantity        Float
  referenceId     String?   // Purchase ID or Invoice ID
  referenceType   String?   // PURCHASE or SALE or DAMAGE
  notes           String?
  createdAt       DateTime  @default(now())

  // Relations
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([createdAt])
  @@index([movementType])
}

// Accounting (Module 8)
model Ledger {
  id              String    @id @default(cuid())
  customerId      String?
  supplierId      String?
  entryDate       DateTime
  description     String
  debit           Float     @default(0)
  credit          Float     @default(0)
  balance         Float
  ledgerType      String    // SALES, PURCHASE, EXPENSE, INCOME

  createdAt       DateTime  @default(now())

  // Relations
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([entryDate])
  @@index([ledgerType])
}

model Expense {
  id              String    @id @default(cuid())
  category        String
  amount          Float
  description     String
  expenseDate     DateTime
  notes           String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([expenseDate])
  @@index([category])
}

// Rate History (Module 9)
model RateHistory {
  id              String    @id @default(cuid())
  productId       String
  market          MarketLocation
  rate            Float
  date            DateTime
  notes           String?

  createdAt       DateTime  @default(now())

  // Relations
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([date])
  @@index([market])
}

// Payment Tracking
model SupplierPayment {
  id              String    @id @default(cuid())
  purchaseId      String
  supplierId      String
  amount          Float
  paymentDate     DateTime
  paymentMethod   String    // CASH, CHEQUE, BANK, DIGITAL
  reference       String?
  notes           String?

  createdAt       DateTime  @default(now())

  // Relations
  purchase        Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  supplier        Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([paymentDate])
}

model CustomerPayment {
  id              String    @id @default(cuid())
  invoiceId       String
  customerId      String
  amount          Float
  paymentDate     DateTime
  paymentMethod   String    // CASH, CHEQUE, BANK, DIGITAL
  reference       String?
  notes           String?
  reversedAt      DateTime?

  createdAt       DateTime  @default(now())

  // Relations
  invoice         Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([paymentDate])
}
